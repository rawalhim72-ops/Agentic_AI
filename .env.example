# LLM Configuration
# -------------------------------------------------------------
# Option 1: Groq (Recommended - High Speed & High Quality)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Alternative Groq models: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

# Option 2: OpenAI / Compatible
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
# Options: 'sentence-transformers' (local offline) or 'openai'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Configuration
DATABASE_PATH=data/student_support.db
VECTOR_STORE_DIR=data/vector_store
LOGS_DIR=data/logs

# Langfuse Tracing Configuration (Optional - fallback to local JSON/SQLite logging if omitted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
